{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["aws-portal:ViewBilling", "aws-portal:ViewUsage", "account:GetAccountInformation"],
      "Resource": "*"
    },
    {
      "Effect": "Deny",
      "Action": ["ec2:*", "s3:*", "iam:*", "rds:*"],
      "Resource": "*"
    }
  ]
}
